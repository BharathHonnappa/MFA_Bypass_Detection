MFA_GUARD_ENV=production
MFA_GUARD_SECRET_KEY=replace-with-a-long-random-secret
MFA_GUARD_DB=/var/lib/mfa-guard/mfa_security.db
MFA_GUARD_COOKIE_SECURE=true
MFA_GUARD_COOKIE_SAMESITE=Lax
MFA_GUARD_SESSION_MINUTES=60
MFA_GUARD_BIND=127.0.0.1:8000

# Development only. Keep false in production.
MFA_GUARD_DEV_LOG_OTP=false

# Email MFA delivery. Configure these for production MFA code delivery.
MFA_GUARD_MFA_FROM_EMAIL=mfa-guard@example.com
MFA_GUARD_SMTP_HOST=smtp.example.com
MFA_GUARD_SMTP_PORT=587
MFA_GUARD_SMTP_USERNAME=
MFA_GUARD_SMTP_PASSWORD=
MFA_GUARD_SMTP_TLS=true
